	)
	(text "We're going to do two things, \nsince we don't necessarily have a guarantee \nthat the circuitry to drive the sensor is going to work, \nand we don't have time to iterate the board.\n\nWe're going to do the full implementation of the circuitry \non the rigid board, and hope that it'll work out.\n\nHowever, in the event that it fails for some reason\n(did a bad job, custom flex cable too long, etc)\nwe'll be able to fall back to the COTS rigid board \nusing the standard 22pin connector."
		(exclude_from_sim no)
		(at 281.178 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "5df8bce1-950d-4c1f-b1f9-75745f75d807")
	)
